# Server
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000

# Ma'lumotlar bazasi.
# Produksiyada PostgreSQL: DATABASE_URL=postgres://user:parol@localhost:5432/edukitob
# Agar DATABASE_URL bo'sh bo'lsa, lokal rejim uchun ichki SQLite (data/edukitob.db) ishlatiladi.
DB_CLIENT=auto
DATABASE_URL=

# Maxfiy kalitlar (produksiyada albatta o'zgartiring, hech kimga bermang)
DOWNLOAD_SIGN_SECRET=ozgartiring-tasodifiy-uzun-satr
SESSION_TTL_HOURS=24

# Dastlabki admin (faqat `npm run seed` uchun)
ADMIN_NAME=Bosh admin
ADMIN_EMAIL=admin@edukitob.uz
ADMIN_PASSWORD=BoshlangichParol123!

# Yuklash limitlari
MAX_PDF_MB=100
MAX_IMAGE_MB=5
